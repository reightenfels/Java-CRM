<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev.controllers.EmployeeChats">
   <right>
      <StackPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="750.0" prefWidth="800.0" style="-fx-background-color: #3D3030;" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="BOTTOM_LEFT" style="-fx-border-width: 0 0 0 2; -fx-border-color: #3D3030;" stylesheets="@style.css">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #261E1E;">
                     <children>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/attachment-icon.png" />
                           </image>
                           <HBox.margin>
                              <Insets left="18.0" />
                           </HBox.margin>
                        </ImageView>
                        <TextArea maxHeight="20.0" promptText="Сообщение..." style="-fx-prompt-text-fill: #FFF; -fx-text-fill: #FFF;" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets left="30.0" right="20.0" />
                           </HBox.margin>
                           <font>
                              <Font size="14.0" />
                           </font>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </TextArea>
                        <ImageView fitHeight="27.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/send-message-icon.png" />
                           </image>
                           <HBox.margin>
                              <Insets right="28.0" />
                           </HBox.margin>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children></StackPane>
   </right>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="1000.0" style="-fx-background-color: #261E1E; -fx-border-width: 1 0 1 0; -fx-border-color: #D4D4D4;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: #fff;" text="Чат сотрудников">
               <font>
                  <Font size="18.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>
   <left>
      <ListView fx:id="dialogsListView" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #261E1E;" BorderPane.alignment="CENTER" />
   </left>
</BorderPane>
