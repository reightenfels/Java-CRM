<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev.controllers.TasksListController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="1000.0" style="-fx-background-color: #261E1E; -fx-border-width: 1 0 1 0; -fx-border-color: #D4D4D4;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: #fff;" text="Мои задачи">
               <font>
                  <Font size="18.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <HBox prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleCreateTaskClickBtn" prefWidth="93.0" style="-fx-background-color: #08D448; -fx-text-fill: #FFF; -fx-background-radius: 5;" text="Создать">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <StackPane alignment="TOP_LEFT" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: #3D3030;">
         <children>
            <ScrollPane fx:id="columnsListScrollPane" fitToHeight="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #3D3030;" vbarPolicy="NEVER">
               <StackPane.margin>
                  <Insets top="20.0" />
               </StackPane.margin>
               <content>
                  <HBox fx:id="statusesColumnsHBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #3D3030;" />
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
