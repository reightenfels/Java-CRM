<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<BorderPane prefHeight="720.0" prefWidth="1000.0" style="-fx-background-color: #3D3030;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <BorderPane prefHeight="50.0" prefWidth="1000.0" style="-fx-background-color: #000;" BorderPane.alignment="CENTER">
         <center>
            <Label style="-fx-text-fill: #fff;" text="Создание задачи" BorderPane.alignment="CENTER">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
         </center>
      </BorderPane>
   </top>
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <top>
            <HBox alignment="CENTER" prefHeight="40.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
               <children>
                  <TextField fx:id="login" prefWidth="500.0" promptText="Название задачи" style="-fx-border-color: transparent transparent #fff transparent; -fx-background-color: transparent; -fx-prompt-text-fill: #fff; -fx-text-fill: #fff;" styleClass="formTextInput">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>
         </top>
      </BorderPane>
   </center>
</BorderPane>
