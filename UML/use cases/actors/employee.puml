@startuml Сотрудник

actor Сотрудник

' Сотрудник
rectangle "Авторизация" {
    usecase "Войти в систему" as Auth
    usecase "Зарегистрироваться \n в системе" as Registration
}

Сотрудник --> Auth
Сотрудник --> Registration

rectangle "Модуль сообщений" {
    usecase "Отправить сообщение" as SendMessage
    usecase "В чат с сотрудником" as SendMessageToEmpl
    usecase "В чат задачи" as SendMessageToTask
    usecase "Прикрепить вложение \n к сообщению" as AddAttachmentToMessage

    SendMessageToEmpl --> SendMessage
    SendMessageToTask --> SendMessage

    AddAttachmentToMessage ..> SendMessage <<extend>>
}

Сотрудник --> SendMessage

rectangle "Модуль диалогов" {
    usecase "Открыть диалог" as OpenDialog
    usecase "С сотрудником" as OpenEmployeeDialog
    usecase "По задаче" as OpenTaskDialog

    usecase "Открыть список \n диалогов" as OpenDialogsList
    usecase "По задачам" as OpenTasksDialogsList
    usecase "С сотрудникаи" as OpenEmployeesDialogsList

    usecase "Удалить диалог" as DeleteDialog
    usecase "С сотрудинком" as DeleteEmployeeDialog

    OpenEmployeeDialog --> OpenDialog
    OpenTaskDialog --> OpenDialog

    DeleteEmployeeDialog --> DeleteDialog

    OpenTasksDialogsList --> OpenDialogsList
    OpenEmployeesDialogsList --> OpenDialogsList
}

Сотрудник --> OpenDialog
Сотрудник --> DeleteDialog
Сотрудник --> OpenDialogsList


@enduml